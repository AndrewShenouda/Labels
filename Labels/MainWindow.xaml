<Window x:Class="Labels.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Labels.Ui"
        Title="Labels" Width="1180" Height="800" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Text1}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True" Icon="Assets/AppIcon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="LabelArt">
            <Grid>
                <Border Width="96" Height="138" Background="White" CornerRadius="10" BorderBrush="#14000000" BorderThickness="0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.2" Direction="270"/>
                    </Border.Effect>
                    <StackPanel Margin="11,12">
                        <Grid Height="16">
                            <Rectangle Width="18" Height="16" Fill="#1D1D1F" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"/>
                            <StackPanel HorizontalAlignment="Right" Width="42">
                                <Rectangle Height="3.5" Fill="#C7C7CC" RadiusX="1.75" RadiusY="1.75" Margin="0,1,0,4"/>
                                <Rectangle Height="3.5" Fill="#C7C7CC" RadiusX="1.75" RadiusY="1.75" Width="28" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1.2" Fill="#1D1D1F" Margin="0,8,0,8"/>
                        <Rectangle Height="3.5" Fill="#C7C7CC" RadiusX="1.75" RadiusY="1.75" Width="34" HorizontalAlignment="Left"/>
                        <Rectangle Height="3.5" Fill="#C7C7CC" RadiusX="1.75" RadiusY="1.75" Width="56" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <Rectangle Height="3.5" Fill="#C7C7CC" RadiusX="1.75" RadiusY="1.75" Width="46" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <Rectangle Height="1.2" Fill="#1D1D1F" Margin="0,10,0,7"/>
                        <Grid Height="32">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.08,0" SpreadMethod="Repeat">
                                    <GradientStop Color="#1D1D1F" Offset="0"/>
                                    <GradientStop Color="#1D1D1F" Offset="0.45"/>
                                    <GradientStop Color="White" Offset="0.45"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="QueueItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="63" Background="White" CornerRadius="5" BorderBrush="#1A000000" BorderThickness="0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.14" Direction="270"/>
                    </Border.Effect>
                    <Image Source="{Binding OutputPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="1.5"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text1}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CopiesText}" Style="{StaticResource Secondary}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="63" Background="White" CornerRadius="5" BorderBrush="#1A000000" BorderThickness="0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.14" Direction="270"/>
                    </Border.Effect>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="1.5"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text1}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">

        <!-- ================= Backdrop: everything the glass refracts ================= -->
        <Grid x:Name="Backdrop" Background="{DynamicResource AppBg}">
            <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="{DynamicResource GlowOpacity}">
                <Ellipse Width="760" Height="620" Canvas.Left="-200" Canvas.Top="-180">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Glow1}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="GlowRight" Width="820" Height="700" Canvas.Left="760" Canvas.Top="260">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Glow2}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="640" Height="520" Canvas.Left="120" Canvas.Top="480">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Glow3}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Label preview -->
            <Grid x:Name="Stage" Margin="272,92,336,52">
                <Viewbox x:Name="PaperView" Stretch="Uniform" StretchDirection="DownOnly" Visibility="Hidden">
                    <Grid Margin="30">
                        <Border x:Name="PaperGhost" Width="406" Height="609" CornerRadius="8" Background="White" Margin="0,18,0,-18" Opacity="0.35">
                            <Border.Effect><BlurEffect Radius="40"/></Border.Effect>
                        </Border>
                        <Border x:Name="PaperCard" Width="406" Height="609" Background="White" CornerRadius="8" BorderBrush="#14000000" BorderThickness="0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Direction="270"/>
                            </Border.Effect>
                            <Grid x:Name="PaperHost" Margin="2" Background="Transparent"
                                  MouseLeftButtonDown="Paper_MouseDown" MouseMove="Paper_MouseMove" MouseLeftButtonUp="Paper_MouseUp"
                                  MouseLeave="Paper_MouseLeave" MouseWheel="Paper_MouseWheel">
                                <Image x:Name="PaperImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="StampOverlay" IsHitTestVisible="False">
                                    <Rectangle x:Name="StampOutline" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="3 2"
                                               RadiusX="4" RadiusY="4" Opacity="0" Fill="{DynamicResource AccentSoft}"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- ================= Crop stage (immersive, like Photos) ================= -->
        <Grid x:Name="CropStage" Background="{DynamicResource CropStage}" Visibility="Collapsed" Opacity="0">
            <Canvas x:Name="CropCanvas" Margin="40,60,40,120" ClipToBounds="False" Background="Transparent"
                    SizeChanged="CropCanvas_SizeChanged" MouseLeftButtonDown="CropCanvas_MouseDown"
                    MouseMove="CropCanvas_MouseMove" MouseLeftButtonUp="CropCanvas_MouseUp">
                <Image x:Name="CropImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                <Path x:Name="CropShade" Fill="#A6000000" IsHitTestVisible="False"/>
                <Canvas x:Name="CropGrid" IsHitTestVisible="False" Opacity="0">
                    <Line x:Name="GridV1" Stroke="#80FFFFFF" StrokeThickness="0.75"/>
                    <Line x:Name="GridV2" Stroke="#80FFFFFF" StrokeThickness="0.75"/>
                    <Line x:Name="GridH1" Stroke="#80FFFFFF" StrokeThickness="0.75"/>
                    <Line x:Name="GridH2" Stroke="#80FFFFFF" StrokeThickness="0.75"/>
                </Canvas>
                <Rectangle x:Name="CropFrame" Stroke="White" StrokeThickness="1.25" IsHitTestVisible="False"/>
                <Path x:Name="CropCorners" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False">
                    <Path.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.4"/></Path.Effect>
                </Path>
            </Canvas>
            <TextBlock x:Name="CropHint" Text="Drag the corners to fit the label" Foreground="#D9FFFFFF" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"/>
        </Grid>

        <!-- ================= Chrome: floating glass ================= -->
        <Grid x:Name="Chrome" Visibility="Collapsed">
            <!-- Sidebar -->
            <ui:GlassPanel x:Name="Sidebar" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}"
                           CornerRadius="26" Width="252" HorizontalAlignment="Left" Margin="10" Padding="12,14,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="6,0,0,0" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/AppIcon.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Labels" Style="{StaticResource Headline}" FontSize="16" Margin="9,0,0,1" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource GlassIconButton}" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="AddFile_Click" ToolTip="Add labels (Ctrl+O)">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14"/>
                        </Button>
                    </Grid>
                    <ui:Segmented x:Name="ListSwitch" Grid.Row="1" Items="Queue|History" Margin="2,14,2,12" SelectionChanged="ListSwitch_SelectionChanged"/>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="LabelList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SidebarItem}"
                                 ItemTemplate="{StaticResource QueueItem}" SelectionChanged="LabelList_SelectionChanged" KeyDown="LabelList_KeyDown"/>
                        <ListBox x:Name="HistoryList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SidebarItem}"
                                 ItemTemplate="{StaticResource HistoryItem}" SelectionChanged="HistoryList_SelectionChanged" Visibility="Collapsed"/>
                        <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="12">
                            <TextBlock x:Name="ListEmptyIcon" Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Text3}"/>
                            <TextBlock x:Name="ListEmptyText" Text="Nothing printed yet" Style="{StaticResource Secondary}" FontSize="13" Margin="0,10,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="DownloadBanner" Grid.Row="3" Style="{StaticResource InsetGroup}" Padding="14,11" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="New in Downloads" Style="{StaticResource Secondary}" FontSize="11"/>
                                <TextBlock x:Name="DownloadBannerName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource CapsuleButton}" Height="28" Padding="14,0" Margin="10,0,0,0" Click="DownloadBannerAdd_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </ui:GlassPanel>

            <!-- Center header -->
            <Grid x:Name="Header" Margin="286,10,336,0" VerticalAlignment="Top" Height="64">
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Title2}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <ui:GlassPanel x:Name="ToolCapsule" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}"
                               CornerRadius="22" HorizontalAlignment="Right" VerticalAlignment="Center" Height="44" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RotateButton" Style="{StaticResource GlassIconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Rotate_Click" ToolTip="Rotate (R)">
                            <TextBlock Text="&#xE7AD;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button x:Name="CropButton" Style="{StaticResource GlassIconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Crop_Click" ToolTip="Crop (C)">
                            <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button x:Name="StampButton" Style="{StaticResource GlassIconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="StampButton_Click" ToolTip="Add a stamp (S)">
                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>
                        <Button Style="{StaticResource GlassIconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Remove_Click" ToolTip="Remove (Delete)">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                        </Button>
                    </StackPanel>
                </ui:GlassPanel>
            </Grid>

            <!-- Tracking chip + footer under the preview -->
            <StackPanel x:Name="Footer" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="272,0,336,18" Orientation="Horizontal">
                <TextBlock x:Name="FooterText" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Inspector -->
            <ui:GlassPanel x:Name="Inspector" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}"
                           CornerRadius="26" Width="316" HorizontalAlignment="Right" Margin="10,50,10,10" Padding="16,16,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Printer -->
                            <Border Style="{StaticResource InsetGroup}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ControlFill}">
                                        <Grid>
                                            <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="19"/>
                                            <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{DynamicResource Text3}" Stroke="{DynamicResource GlassShadowFill}" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PrinterNameText" Text="AE240-BT" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StatusText" Text="Checking…" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="PrinterDetailText" Style="{StaticResource Secondary}" FontSize="11" Margin="0,1,0,0" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" Click="RefreshStatus_Click" ToolTip="Check status">
                                            <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform x:Name="RefreshSpin"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" Click="Settings_Click" ToolTip="Settings">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Options -->
                            <TextBlock x:Name="OptionsHeader" Text="Options" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                            <Border x:Name="OptionsGroup" Style="{StaticResource InsetGroup}">
                                <StackPanel>
                                    <Grid Height="52">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copies" FontSize="13.5"/>
                                            <TextBlock x:Name="CopiesHint" Text="For this label" Style="{StaticResource Secondary}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ControlFill}" CornerRadius="17" Height="34">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GlassIconButton}" Width="34" Height="34" Click="CopiesMinus_Click">
                                                    <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                                <TextBlock x:Name="CopiesText" Text="1" Width="26" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                                <Button Style="{StaticResource GlassIconButton}" Width="34" Height="34" Click="CopiesPlus_Click">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <StackPanel Margin="0,12,0,10">
                                        <Grid>
                                            <TextBlock Text="Darkness" FontSize="13.5"/>
                                            <TextBlock x:Name="DensityText" Style="{StaticResource Secondary}" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Text3}"/>
                                            <Slider x:Name="DensitySlider" Grid.Column="1" Style="{StaticResource LiquidSlider}" Minimum="0" Maximum="15"
                                                    Margin="10,0" ValueChanged="DensitySlider_ValueChanged"/>
                                            <TextBlock Grid.Column="2" Text="&#xE706;" Style="{StaticResource Icon}" FontSize="17"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stamp -->
                            <StackPanel x:Name="StampSection" Visibility="Collapsed">
                                <TextBlock Text="Stamp" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                                <Border Style="{StaticResource InsetGroup}">
                                    <StackPanel>
                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="58" Height="38" CornerRadius="8" Background="White" BorderBrush="#1A000000" BorderThickness="0.5">
                                                <Image x:Name="StampThumb" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="StampName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Drag it on the label to move" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="30" Height="30" Click="RemoveStamp_Click" ToolTip="Remove stamp">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                        <StackPanel Margin="0,10,0,6">
                                            <TextBlock Text="Size" FontSize="13.5"/>
                                            <Slider x:Name="StampSize" Style="{StaticResource LiquidSlider}" Minimum="0.15" Maximum="0.95"
                                                    IsSnapToTickEnabled="False" SmallChange="0.02" LargeChange="0.08" Margin="0,2,0,0"
                                                    ValueChanged="StampSize_ValueChanged"/>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                        <Grid Height="50">
                                            <TextBlock Text="Style" VerticalAlignment="Center" FontSize="13.5"/>
                                            <ui:Segmented x:Name="StampStyle" Items="Solid|Faint" Width="150" HorizontalAlignment="Right" SelectionChanged="StampStyle_SelectionChanged"/>
                                        </Grid>
                                        <Border x:Name="StampWarning" CornerRadius="10" Background="#1FFF9F0A" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                <TextBlock Text="Covers part of the label. Drag it to an empty spot or use Faint." TextWrapping="Wrap" FontSize="12" Width="210"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="StampAllButton" Content="Add to All Labels in Queue" Style="{StaticResource CapsuleButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch" Click="StampAll_Click"/>
                            </StackPanel>

                            <!-- Shipment details -->
                            <StackPanel x:Name="ShipmentSection" Visibility="Collapsed">
                                <TextBlock Text="Shipment" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                                <Border Style="{StaticResource InsetGroup}" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Border x:Name="CarrierBadge" CornerRadius="7" Padding="8,3" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="CarrierText" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="CopyTrackingButton" Style="{StaticResource GlassIconButton}" Width="30" Height="30" Click="CopyTracking_Click" ToolTip="Copy tracking number">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </Button>
                                                <Button x:Name="TrackButton" Style="{StaticResource GlassIconButton}" Width="30" Height="30" Click="Track_Click" ToolTip="Track package">
                                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TrackingText" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TrackingHint" Text="Read from the label" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Print -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Grid>
                            <Button x:Name="PrintButton" Style="{StaticResource ProminentButton}" Click="Print_Click" ToolTip="Print (Ctrl+P)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="16" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="PrintButtonText" Text="Print"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="ProgressPanel" Height="50" CornerRadius="25" Background="{DynamicResource ControlFill}" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource GlassRim}" BorderThickness="0.75" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="ProgressFill" Background="{DynamicResource ProminentFill}" HorizontalAlignment="Left" Width="0" CornerRadius="25" Opacity="0.9"/>
                                    <TextBlock x:Name="ProgressText" Text="Connecting…" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Margin="6,12,6,0">
                            <TextBlock x:Name="SummaryText" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <Button x:Name="FeedButton" Content="Feed Label" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="Feed_Click"/>
                            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="CancelPrint_Click" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ui:GlassPanel>
        </Grid>

        <!-- Stamp menu (glass popover under the toolbar) -->
        <Grid x:Name="StampMenu" Visibility="Collapsed">
            <Border Background="Transparent" MouseLeftButtonDown="StampMenuScrim_MouseDown"/>
            <ui:GlassPanel x:Name="StampMenuCard" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTintStrong}" CornerRadius="22"
                           Width="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,340,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Add a Stamp" Style="{StaticResource Headline}" FontSize="14" Margin="12,6,0,8"/>
                    <Button Style="{StaticResource RowButton}" Click="StampFragile_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="44" CornerRadius="8" Background="White" BorderBrush="#1A000000" BorderThickness="0.5">
                                <Image x:Name="FragileThumb" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Fragile" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Text1}"/>
                                <TextBlock Text="Handle With Care" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ItemsControl x:Name="RecentStampList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Click="StampRecent_Click" Tag="{Binding Path}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="44" CornerRadius="8" Background="White" BorderBrush="#1A000000" BorderThickness="0.5">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Your image" Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource RowButton}" Click="StampChoose_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="44" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Accent}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Choose Image…" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Text1}"/>
                                <TextBlock Text="PNG with transparency works best" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle x:Name="StampMenuSep" Height="1" Fill="{DynamicResource Separator}" Margin="10,6"/>
                    <CheckBox x:Name="StampToAll" Style="{StaticResource Switch}" Height="44" Margin="12,0,6,2" Content="Add to every label in the queue"/>
                </StackPanel>
            </ui:GlassPanel>
        </Grid>

        <!-- Crop toolbar (floats at the bottom of the crop stage) -->
        <ui:GlassPanel x:Name="CropBar" Backdrop="{Binding ElementName=CropStage}" Tint="{DynamicResource GlassTint}" CornerRadius="32"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Height="64" Padding="10" Visibility="Collapsed">
            <ui:GlassPanel.Resources>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ui:GlassPanel.Resources>
            <StackPanel Orientation="Horizontal" TextElement.Foreground="#F5F5F7">
                <Button Style="{StaticResource CircleGlassButton}" Click="CropCancel_Click" ToolTip="Cancel (Esc)">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14"/>
                </Button>
                <ui:Segmented x:Name="CropModeSwitch" Items="Auto|Whole Page|Custom" Width="300" Height="36" Margin="14,0" SelectionChanged="CropMode_SelectionChanged"/>
                <Button Style="{StaticResource CircleProminentButton}" Click="CropDone_Click" ToolTip="Done (Enter)">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="16" Foreground="White"/>
                </Button>
            </StackPanel>
        </ui:GlassPanel>

        <!-- ================= Empty state ================= -->
        <Grid x:Name="EmptyState">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="500" VerticalAlignment="Center" Margin="0,56,0,40">
                    <ContentControl x:Name="EmptyArt" ContentTemplate="{StaticResource LabelArt}" HorizontalAlignment="Center" Focusable="False" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform><TranslateTransform x:Name="ArtFloat"/></ContentControl.RenderTransform>
                    </ContentControl>
                    <TextBlock Text="Drop a Shipping Label" Style="{StaticResource LargeTitle}" HorizontalAlignment="Center" Margin="0,34,0,0"/>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="30,10,30,0" LineHeight="21"
                               Text="PDF or image, any page size. Labels are found, turned upright and fitted to your label size for you."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource ProminentButton}" Height="44" FontSize="14" Padding="24,0" Click="AddFile_Click" Content="Choose File…"/>
                        <Button Style="{StaticResource CapsuleButton}" Height="44" Padding="24,0" Margin="12,0,0,0" Click="Paste_Click" Content="Paste"/>
                    </StackPanel>

                    <ui:GlassPanel Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}" CornerRadius="24" Margin="0,40,0,0" Padding="8,12,8,8">
                        <StackPanel>
                            <Grid Margin="12,2,10,6">
                                <TextBlock Text="Recent Downloads" Style="{StaticResource Headline}" FontSize="13.5"/>
                                <Button Content="Show in Folder" Style="{StaticResource LinkButton}" FontSize="12.5" HorizontalAlignment="Right" Click="OpenDownloads_Click"/>
                            </Grid>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Click="RecentItem_Click" Tag="{Binding Path}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                                <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RecentEmpty" Text="No PDFs or images downloaded in the last week." Style="{StaticResource Secondary}"
                                       HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed"/>
                        </StackPanel>
                    </ui:GlassPanel>

                    <ui:GlassPanel Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}" CornerRadius="18" Height="36"
                                   HorizontalAlignment="Center" Margin="0,22,0,0" Padding="14,0,8,0" Shadow="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EmptyStatusDot" Width="8" Height="8" Fill="{DynamicResource Text3}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStatusText" Text="AE240-BT · Checking…" Style="{StaticResource Secondary}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GlassIconButton}" Width="28" Height="28" Margin="6,0,0,0" Click="Settings_Click" ToolTip="Settings">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </ui:GlassPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,14,0,0">
                <Image Source="Assets/AppIcon.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Labels" Style="{StaticResource Headline}" FontSize="16" Margin="9,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:GlassPanel Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}" CornerRadius="20" Height="40"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="128,10,0,0" Padding="4,0" Shadow="False">
                <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" Click="ShowHistory_Click" ToolTip="Print history" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14"/>
                </Button>
            </ui:GlassPanel>
        </Grid>

        <!-- ================= Drop overlay ================= -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
            <Border Margin="14" CornerRadius="28" Background="{DynamicResource DropHighlight}">
                <Grid>
                    <Rectangle RadiusX="28" RadiusY="28" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeDashArray="4 3"/>
                    <ui:GlassPanel x:Name="DropBubble" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTint}" CornerRadius="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,24">
                        <StackPanel>
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Drop to Add" Style="{StaticResource Headline}" FontSize="17" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:GlassPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Busy ================= -->
        <ui:GlassPanel x:Name="BusyOverlay" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTintStrong}" CornerRadius="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Height="52" Padding="20,0,24,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Grid.RenderTransform>
                    <Ellipse Stroke="{DynamicResource ControlHover}" StrokeThickness="2.5"/>
                    <Path Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 10,1.25 A 8.75,8.75 0 0 1 18.75,10"/>
                </Grid>
                <TextBlock x:Name="BusyText" Text="Preparing label…" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </ui:GlassPanel>

        <!-- ================= Toast ================= -->
        <ui:GlassPanel x:Name="Toast" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTintStrong}" CornerRadius="24"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Height="48" Padding="16,0,22,0"
                       Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastIcon" Text="&#xE930;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Success}"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </ui:GlassPanel>

        <!-- ================= Settings sheet ================= -->
        <Grid x:Name="SettingsSheet" Visibility="Collapsed">
            <Border x:Name="SettingsScrim" Background="{DynamicResource Scrim}" MouseLeftButtonDown="SettingsScrim_MouseDown"/>
            <ui:GlassPanel x:Name="SettingsCard" Backdrop="{Binding ElementName=Backdrop}" Tint="{DynamicResource GlassTintStrong}" CornerRadius="30"
                           Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,18,18,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Settings" Style="{StaticResource Title2}"/>
                        </StackPanel>
                        <Button Style="{StaticResource CircleProminentButton}" Width="38" Height="38" HorizontalAlignment="Right" Click="SettingsDone_Click" ToolTip="Done">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="White"/>
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
                        <StackPanel Margin="22,4,22,24">
                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="Printer" Style="{StaticResource SectionHeader}" Margin="6,0,0,0"/>
                                <Button Content="Refresh" Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Right" Click="RefreshPorts_Click"/>
                            </Grid>
                            <Border Style="{StaticResource InsetGroup}" Padding="4">
                                <Grid>
                                    <ListBox x:Name="PortList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CheckRow}" MaxHeight="150"
                                             DisplayMemberPath="Display"/>
                                    <TextBlock x:Name="NoPortsText" Text="No printers found. Pair a Bluetooth printer or install your USB printer's Windows driver."
                                               Style="{StaticResource Secondary}" Margin="12,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Bluetooth printers connect directly. USB printers print through their Windows driver — install it and plug the printer in." Style="{StaticResource Secondary}" Margin="8,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Labels" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                            <Border Style="{StaticResource InsetGroup}" Padding="4">
                                <StackPanel>
                                    <ListBox x:Name="SizeList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CheckRow}"
                                             DisplayMemberPath="Display" SelectionChanged="SizeList_SelectionChanged"/>
                                    <Grid x:Name="CustomSizeRow" Margin="12,2,12,8" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ControlFill}" CornerRadius="8" Width="72" Height="32">
                                                <TextBox x:Name="CustomW" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text1}"
                                                         CaretBrush="{DynamicResource Text1}" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13.5"/>
                                            </Border>
                                            <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Text2}"/>
                                            <Border Background="{DynamicResource ControlFill}" CornerRadius="8" Width="72" Height="32">
                                                <TextBox x:Name="CustomH" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text1}"
                                                         CaretBrush="{DynamicResource Text1}" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13.5"/>
                                            </Border>
                                            <TextBlock Text="inches (width × height)" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="12,2"/>
                                    <Grid Height="54" Margin="12,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Resolution" FontSize="13.5"/>
                                            <TextBlock Text="Printed on the printer's label or box" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:Segmented x:Name="DpiSwitch" Items="203 dpi|300 dpi" Width="180" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Printing" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                            <Border Style="{StaticResource InsetGroup}">
                                <StackPanel>
                                    <Grid Height="58">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Label roll" FontSize="13.5"/>
                                            <TextBlock Text="Continuous is for rolls with no gaps" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:Segmented x:Name="MediaSwitch" Items="Gaps|Continuous" Width="190" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <Grid Height="52">
                                        <TextBlock Text="Speed" VerticalAlignment="Center" FontSize="13.5"/>
                                        <ui:Segmented x:Name="SpeedSwitch" Items="Slower|Normal|Faster" Width="230" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}" Height="50" Content="Bottom of label comes out first"/>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <CheckBox x:Name="ClearSwitch" Style="{StaticResource Switch}" Height="50" Content="Clear queue after printing"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Downloads" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                            <Border Style="{StaticResource InsetGroup}">
                                <StackPanel>
                                    <CheckBox x:Name="WatchSwitch" Style="{StaticResource Switch}" Height="50" Content="Suggest new labels from Downloads"/>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <CheckBox x:Name="AutoPrintSwitch" Style="{StaticResource Switch}" Height="58">
                                        <StackPanel>
                                            <TextBlock Text="Print new labels automatically" FontSize="13.5"/>
                                            <TextBlock Text="Shipping PDFs saved to Downloads print right away" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeader}" Margin="6,20,0,8"/>
                            <Border Style="{StaticResource InsetGroup}">
                                <StackPanel>
                                    <Grid Height="54">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Calibrate" FontSize="13.5"/>
                                            <TextBlock Text="After loading a new roll, or for a red light" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Content="Calibrate" Style="{StaticResource CapsuleButton}" HorizontalAlignment="Right" Height="30" Click="Calibrate_Click"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <Grid Height="54">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Test label" FontSize="13.5"/>
                                            <TextBlock Text="Check alignment and darkness" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Content="Print Test" Style="{StaticResource CapsuleButton}" HorizontalAlignment="Right" Height="30" Click="TestLabel_Click"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}"/>
                                    <CheckBox x:Name="InvertSwitch" Style="{StaticResource Switch}" Height="50" Content="Labels print as a negative"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:GlassPanel>
        </Grid>

        <!-- ================= Caption buttons ================= -->
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
