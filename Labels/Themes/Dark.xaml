<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Text1" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Text2" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="Text3" Color="#7C7C82"/>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <SolidColorBrush x:Key="Accent" Color="#3D9BFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#400A84FF"/>
    <SolidColorBrush x:Key="Success" Color="#30D158"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB340"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6961"/>

    <SolidColorBrush x:Key="AppBg" Color="#121216"/>
    <Color x:Key="Glow1">#1E4C9A</Color>
    <Color x:Key="Glow2">#4B2E86</Color>
    <Color x:Key="Glow3">#145A52</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="GlowOpacity">0.75</sys:Double>

    <SolidColorBrush x:Key="GlassTint" Color="#5C2C2C30"/>
    <SolidColorBrush x:Key="GlassTintStrong" Color="#D9232327"/>
    <SolidColorBrush x:Key="GlassShadowFill" Color="#FF1C1C1E"/>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.45"/>
        <GradientStop Color="#2EFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0"/>
        <GradientStop Color="#05FFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlFill" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="RowSelected" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="RowSelectedRim" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Separator" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SegmentTrack" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SegmentThumb" Color="#FF636366"/>
    <SolidColorBrush x:Key="Knob" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#52787880"/>
    <SolidColorBrush x:Key="InsetGroupFill" Color="#14FFFFFF"/>
    <LinearGradientBrush x:Key="ProminentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3D9BFF" Offset="0"/>
        <GradientStop Color="#FF0A6CEB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProminentRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.5"/>
        <GradientStop Color="#33000000" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="ProminentGlow">#800A84FF</Color>
    <SolidColorBrush x:Key="Scrim" Color="#66000000"/>
    <SolidColorBrush x:Key="CropStage" Color="#FF0A0A0C"/>
    <SolidColorBrush x:Key="DropHighlight" Color="#260A84FF"/>
    <SolidColorBrush x:Key="PaperShadow" Color="#FFFFFFFF"/>
</ResourceDictionary>
