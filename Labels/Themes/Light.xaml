<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Text -->
    <SolidColorBrush x:Key="Text1" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Text2" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Text3" Color="#8E8E93"/>
    <!-- System colors -->
    <Color x:Key="AccentColor">#0A84FF</Color>
    <SolidColorBrush x:Key="Accent" Color="#0A7AFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#260A7AFF"/>
    <SolidColorBrush x:Key="Success" Color="#34C759"/>
    <SolidColorBrush x:Key="Warning" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="Danger" Color="#FF3B30"/>

    <!-- Ambient backdrop the glass refracts -->
    <SolidColorBrush x:Key="AppBg" Color="#EDF0F5"/>
    <Color x:Key="Glow1">#9CC2FF</Color>
    <Color x:Key="Glow2">#D7C6FF</Color>
    <Color x:Key="Glow3">#B9EBDD</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="GlowOpacity">0.85</sys:Double>

    <!-- Glass -->
    <SolidColorBrush x:Key="GlassTint" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="GlassTintStrong" Color="#CCFAFAFC"/>
    <SolidColorBrush x:Key="GlassShadowFill" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.45"/>
        <GradientStop Color="#1F000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Small controls that sit on glass -->
    <SolidColorBrush x:Key="ControlFill" Color="#0F000000"/>
    <SolidColorBrush x:Key="ControlHover" Color="#1A000000"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#26000000"/>
    <SolidColorBrush x:Key="RowSelected" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="RowSelectedRim" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Separator" Color="#17000000"/>
    <SolidColorBrush x:Key="SegmentTrack" Color="#14000000"/>
    <SolidColorBrush x:Key="SegmentThumb" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Knob" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#29787880"/>
    <SolidColorBrush x:Key="InsetGroupFill" Color="#99FFFFFF"/>
    <!-- Prominent (tinted) glass -->
    <LinearGradientBrush x:Key="ProminentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3D9BFF" Offset="0"/>
        <GradientStop Color="#FF0A74FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProminentRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#33003C99" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="ProminentGlow">#660A7AFF</Color>
    <!-- Overlays -->
    <SolidColorBrush x:Key="Scrim" Color="#33000000"/>
    <SolidColorBrush x:Key="CropStage" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="DropHighlight" Color="#1A0A7AFF"/>
    <SolidColorBrush x:Key="PaperShadow" Color="#FFFFFFFF"/>
</ResourceDictionary>
